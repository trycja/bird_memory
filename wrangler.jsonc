{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bird-words-ebird-proxy",
	"main": "worker.mjs",
	"compatibility_date": "2026-11-25",
	"vars": {
		"ALLOWED_ORIGINS": "https://trycja.github.io"
